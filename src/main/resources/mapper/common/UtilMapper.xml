  <insert id="insertFile">
    insert into file (original_name,new_name,path,is_image,size,table_name,table_id)
    values(#{originalName},#{newName},#{path},#{isImage},#{size},#{tableName},#{tableId});
  </insert>

  <select id="selectFileFrom" >
    select id,original_name,new_name,path,is_image,size from file where table_name = #{tableName} and table_id = #{tableId}
  </select>

